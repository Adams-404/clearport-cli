#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

VERSION="0.1.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/clearport"
CONFIG_FILE="$CONFIG_DIR/server.conf"
SERVER_CMD="clearport-server"

usage() {
  cat <<'EOF'
Clearport CLI

Usage:
  clearport start          Start the local llama.cpp server
  clearport chat           Chat with the loaded model in Termux
  clearport models         Show models loaded by the server
  clearport local-models   List local GGUF files
  clearport use <file>     Select a GGUF model
  clearport pull <model>   Download a verified Gemma GGUF into ~/models
  clearport status         Check the server and API
  clearport logs           Follow server logs
  clearport stop           Stop the managed server
  clearport restart        Restart the server
  clearport config         Edit server configuration
  clearport version        Show CLI version
EOF
}

die() { printf 'clearport: %s\n' "$*" >&2; exit 1; }
note() { printf 'clearport: %s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing '$1'. Install it with: pkg install $2"; }

load_config() {
  MODEL_PATH="$HOME/models/model.gguf"
  LLAMA_SERVER_BIN="llama-server"
  HOST="127.0.0.1"
  PORT="8080"
  EXTRA_ARGS="-c 2048 -t 4"
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
  API_BASE="http://127.0.0.1:$PORT/v1"
}

api_ready() {
  curl -fsS --max-time 3 "$API_BASE/models" >/dev/null 2>&1
}

select_default_model() {
  mkdir -p "$CONFIG_DIR"
  local -a candidates
  mapfile -t candidates < <(find "$HOME/models" -maxdepth 1 -type f -iname '*.gguf' 2>/dev/null | sort)
  case "${#candidates[@]}" in
    0) die "No GGUF model found in ~/models. Put a .gguf file there, then run: clearport use <path>" ;;
    1) MODEL_PATH="${candidates[0]}" ;;
    *) printf 'Multiple GGUF files found. Choose one:\n'; printf '  %s\n' "${candidates[@]}"; die "Run: clearport use <path>" ;;
  esac
  printf 'MODEL_PATH=%q\nLLAMA_SERVER_BIN=%q\nHOST=%q\nPORT=%q\nEXTRA_ARGS=%q\n' "$MODEL_PATH" "$LLAMA_SERVER_BIN" "$HOST" "$PORT" "$EXTRA_ARGS" > "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  note "Selected $MODEL_PATH"
}

start_server() {
  load_config
  if api_ready; then note "Server already responding at $API_BASE"; return 0; fi
  if [ ! -f "$MODEL_PATH" ]; then
    if [ -f "$CONFIG_FILE" ]; then die "Configured model does not exist: $MODEL_PATH. Run 'clearport use <path>'."; fi
    select_default_model
    load_config
  fi
  command -v "$SERVER_CMD" >/dev/null 2>&1 || die "Server helper missing. Re-run the installer."
  if command -v termux-wake-lock >/dev/null 2>&1; then termux-wake-lock || true; fi
  "$SERVER_CMD" start
}

show_status() {
  load_config
  if api_ready; then
    note "API is responding at $API_BASE"
    curl -fsS --max-time 3 "$API_BASE/models" | jq -r '.data[]? | "  Model: " + .id'
  else
    "$SERVER_CMD" status || true
    return 1
  fi
}

show_models() {
  load_config
  need curl curl
  need jq jq
  curl -fsS --max-time 5 "$API_BASE/models" | jq -r 'if (.data | length) == 0 then "No models loaded." else .data[] | .id end'
}

show_local_models() {
  local found=0
  mkdir -p "$HOME/models"
  while IFS= read -r file; do printf '%s\n' "$file"; found=1; done < <(find "$HOME/models" -maxdepth 1 -type f -iname '*.gguf' 2>/dev/null | sort)
  [ "$found" -eq 1 ] || note "No GGUF files found in ~/models."
}

use_model() {
  [ "$#" -eq 1 ] || die "Usage: clearport use <path-to-model.gguf>"
  local model
  model="$(realpath "$1" 2>/dev/null || true)"
  [ -n "$model" ] && [ -f "$model" ] || die "Model file not found: $1"
  case "$model" in *.gguf|*.GGUF) ;; *) die "Expected a .gguf file." ;; esac
  mkdir -p "$CONFIG_DIR"
  if [ -f "$CONFIG_FILE" ]; then grep -Ev '^[[:space:]]*MODEL_PATH=' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" || true; else : > "$CONFIG_FILE.tmp"; fi
  printf 'MODEL_PATH=%q\n' "$model" >> "$CONFIG_FILE.tmp"
  mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  note "Selected model: $model"
  note "Run 'clearport restart' to load it."
}

chat() {
  load_config
  need curl curl
  need jq jq
  if ! api_ready; then
    start_server
    note "Waiting for the model API..."
    local attempt=0
    until api_ready; do
      attempt=$((attempt + 1))
      [ "$attempt" -lt 180 ] || die "Server did not become ready. Check 'clearport logs'."
      sleep 1
    done
  fi
  local model_id messages input payload response answer
  model_id="$(curl -fsS --max-time 5 "$API_BASE/models" | jq -r '.data[0].id // empty')"
  messages='[]'
  printf '\nClearport Chat | /clear clears context | /exit quits\n\n'
  while true; do
    printf 'you> '
    IFS= read -r input || break
    case "$input" in
      /exit|/quit|exit|quit) break ;;
      /clear) messages='[]'; note "Conversation context cleared."; continue ;;
      '') continue ;;
    esac
    messages="$(jq -c --arg content "$input" '. + [{role:"user",content:$content}]' <<< "$messages")"
    payload="$(jq -cn --arg model "$model_id" --argjson messages "$messages" '{model:$model,messages:$messages,temperature:0.7,max_tokens:512,stream:false}')"
    printf 'model> '
    response="$(curl -fsS --max-time 300 "$API_BASE/chat/completions" -H 'Content-Type: application/json' -d "$payload" 2>&1)" || {
      printf '\nRequest failed: %s\n' "$response" >&2
      continue
    }
    answer="$(jq -r '.choices[0].message.content // .choices[0].text // empty' <<< "$response" 2>/dev/null || true)"
    [ -n "$answer" ] || { printf '\nCould not parse response: %s\n' "$response" >&2; continue; }
    printf '%s\n\n' "$answer"
    messages="$(jq -c --arg content "$answer" '. + [{role:"assistant",content:$content}]' <<< "$messages")"
  done
  printf '\n'
}

is_gguf() {
  [ -f "$1" ] || return 1
  [ "$(head -c 4 "$1" 2>/dev/null)" = "GGUF" ]
}

pull_model() {
  [ "$#" -eq 1 ] || die "Usage: clearport pull <gemma|gemma-tiny>"
  local key="$1" name url expected sha size
  case "$key" in
    gemma|gemma-1b|1b)
      name="gemma-3-1b-it-Q4_K_M.gguf"
      url="https://huggingface.co/ggml-org/gemma-3-1b-it-GGUF/resolve/main/gemma-3-1b-it-Q4_K_M.gguf"
      expected=806058240
      sha="8ccc5cd1f1b3602548715ae25a66ed73fd5dc68a210412eea643eb20eb75a135"
      size="806 MB"
      ;;
    gemma-tiny|tiny|270m)
      name="gemma-3-270m-Q8_0.gguf"
      url="https://huggingface.co/ggml-org/gemma-3-270m-GGUF/resolve/main/gemma-3-270m-Q8_0.gguf"
      expected=291543744
      sha="e00cf79514204dfe2f4d6943f277ffea7fd8a4c8e955b4b7a869cfc157694881"
      size="292 MB"
      ;;
    *)
      die "Unknown model: $key. Available: gemma (Gemma 3 1B, 806 MB), gemma-tiny (Gemma 3 270M, 292 MB)."
      ;;
  esac

  need curl curl
  mkdir -p "$HOME/models"
  local dest="$HOME/models/$name" have=0
  if [ -f "$dest" ]; then have=$(wc -c < "$dest" | tr -d '[:space:]'); fi

  if [ "$have" -eq "$expected" ]; then
    note "Already downloaded: $dest"
  else
    if [ "$have" -gt 0 ] && [ "$have" -lt "$expected" ]; then
      note "Resuming at $((have / 1000000)) MB of $size"
    else
      rm -f "$dest"
    fi
    note "Downloading $name ($size) to ~/models"
    note "Resumable: if it stops, re-run 'clearport pull $key'."
    # -C - resumes a partial file, which matters on mobile data.
    if ! curl -fL --retry 5 --retry-delay 3 -C - --progress-bar -o "$dest" "$url"; then
      die "Download failed. The partial file is kept; re-run 'clearport pull $key' to resume."
    fi
    have=$(wc -c < "$dest" | tr -d '[:space:]')
    if [ "$have" -ne "$expected" ]; then
      die "Size mismatch: expected $expected bytes, got $have. Re-run 'clearport pull $key' to resume."
    fi
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    note "Verifying checksum..."
    if [ "$(sha256sum "$dest" | cut -d' ' -f1)" != "$sha" ]; then
      rm -f "$dest"
      die "Checksum mismatch; the corrupted download was removed. Try again."
    fi
    note "Checksum verified."
  else
    note "sha256sum unavailable; size verified only."
  fi

  note "Model ready: $dest"
  if [ ! -f "$CONFIG_FILE" ] || ! grep -q '^MODEL_PATH=' "$CONFIG_FILE"; then
    use_model "$dest"
  else
    note "Run 'clearport use $dest' to switch to it."
  fi
}

stop_server() {
  load_config
  "$SERVER_CMD" stop || true
  if command -v termux-wake-unlock >/dev/null 2>&1; then termux-wake-unlock >/dev/null 2>&1 || true; fi
}

case "${1:-help}" in
  start) start_server ;;
  chat) chat ;;
  models) show_models ;;
  local-models) show_local_models ;;
  use) shift; use_model "$@" ;;
  pull) shift; pull_model "$@" ;;
  status) show_status ;;
  logs) "$SERVER_CMD" logs ;;
  stop) stop_server ;;
  restart) stop_server; start_server ;;
  config)
    mkdir -p "$CONFIG_DIR"; touch "$CONFIG_FILE"; chmod 600 "$CONFIG_FILE"
    "${EDITOR:-nano}" "$CONFIG_FILE"
    ;;
  version|-v|--version) printf 'Clearport CLI %s\n' "$VERSION" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
