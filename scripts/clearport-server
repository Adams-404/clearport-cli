#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/clearport/server.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/clearport"
PID_FILE="$STATE_DIR/server.pid"
LOG_FILE="$STATE_DIR/server.log"

load_config() {
  MODEL_PATH="$HOME/models/model.gguf"
  LLAMA_SERVER_BIN="llama-server"
  HOST="127.0.0.1"
  PORT="8080"
  EXTRA_ARGS="-c 2048 -t 4"
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
  [ "$HOST" = "127.0.0.1" ] || {
    echo "Clearport only binds to 127.0.0.1 for safety." >&2
    exit 1
  }
  mkdir -p "$STATE_DIR"
}

api_ready() {
  curl -fsS --max-time 2 "http://127.0.0.1:$PORT/v1/models" >/dev/null 2>&1
}

managed_pid() {
  [ -s "$PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq "$LLAMA_SERVER_BIN" || return 1
  printf '%s' "$pid"
}

start_server() {
  load_config
  if api_ready; then
    echo "An API is already responding at http://127.0.0.1:$PORT/v1"
    return 0
  fi
  if managed_pid >/dev/null; then
    echo "Clearport's server process exists but its API is not responding. Check: clearport logs" >&2
    return 1
  fi
  [ -f "$MODEL_PATH" ] || { echo "Model file not found: $MODEL_PATH" >&2; exit 1; }
  command -v "$LLAMA_SERVER_BIN" >/dev/null 2>&1 || { echo "llama-server not found. Install with: pkg install llama-cpp" >&2; exit 1; }

  local -a extra
  read -r -a extra <<< "$EXTRA_ARGS"
  nohup "$LLAMA_SERVER_BIN" -m "$MODEL_PATH" --host "$HOST" --port "$PORT" "${extra[@]}" >>"$LOG_FILE" 2>&1 </dev/null &
  local pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"
  sleep 1
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    echo "llama-server exited during startup. Run: clearport logs" >&2
    return 1
  fi
  echo "Started llama-server (PID $pid)."
  echo "API: http://127.0.0.1:$PORT/v1"
  echo "Logs: $LOG_FILE"
}

stop_server() {
  load_config
  if ! managed_pid >/dev/null; then
    rm -f "$PID_FILE"
    echo "No Clearport-managed server process is running."
    return 0
  fi
  local pid
  pid="$(managed_pid)"
  kill "$pid" 2>/dev/null || true
  local i
  for i in $(seq 1 10); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  echo "Stopped Clearport server (PID $pid)."
}

status_server() {
  load_config
  if api_ready; then
    echo "API responding: http://127.0.0.1:$PORT/v1"
  elif managed_pid >/dev/null; then
    echo "Server process is running, but the API is not responding."
    return 1
  else
    echo "Clearport server is stopped."
    return 1
  fi
}

logs_server() {
  load_config
  touch "$LOG_FILE"
  tail -n 80 -f "$LOG_FILE"
}

case "${1:-}" in
  start) start_server ;;
  stop) stop_server ;;
  status) status_server ;;
  logs) logs_server ;;
  *) echo "Usage: clearport-server {start|stop|status|logs}" >&2; exit 2 ;;
esac
